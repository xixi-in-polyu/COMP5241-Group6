# Runtime database (pooled) and migrations (direct/unpooled)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Private Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Text AI: openai or deepseek
AI_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
