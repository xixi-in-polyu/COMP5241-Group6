# Runtime database (pooled) and migrations (direct/unpooled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_platform?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/learning_platform?schema=public

# Private Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Unified OpenAI-compatible AI configuration
# Providers: deepseek, polyu, openrouter, openai
AI_PROVIDER=deepseek
AI_ENDPOINT=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=COMP5241 Learning Platform

# Per-teacher AI request limits
AI_HOURLY_LIMIT=20
AI_DAILY_LIMIT=200

# Stored AI context limits and retention
USAGE_CONTEXT_MAX_EVENT_BYTES=2097152
USAGE_CONTEXT_MAX_COURSE_BYTES=104857600
USAGE_CONTEXT_RETENTION_DAYS=30
CRON_SECRET=

# Optional isolated test teacher seed
TEST_TEACHER_PASSWORD=

# Optional real-cloud smoke and Playwright inputs
SMOKE_BASE_URL=http://localhost:3011
SMOKE_TEACHER_EMAIL=ai-assignment-test@local.invalid
SMOKE_TEACHER_PASSWORD=
SMOKE_COURSE_ID=
SMOKE_ASSIGNMENT_ID=
