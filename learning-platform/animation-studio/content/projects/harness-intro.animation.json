    {
      "id": "scene-02",
      "chapterId": "ch-harness",
      "title": "What the harness adds",
      "template": "concept",
      "duration": 30,
      "knowledgeNodeIds": [],
      "captionMode": "bottom",
      "camera": {
        "zoomFrom": 1,
        "zoomTo": 1.035,
        "panX": -0.4,
        "panY": 0
      },
      "narration": [
        {
          "id": "scene-02-n1",
          "text": "The harness gives the model hands: a shell, files, search, a browser, and APIs it can call through a tool interface.",
          "start": 0,
          "end": 9.5
        },
        {
          "id": "scene-02-n2",
          "text": "It also manages context: the system prompt, session history, retrieved documents, and summaries that keep the model oriented.",
          "start": 9.5,
          "end": 19
        },
        {
          "id": "scene-02-n3",
          "text": "And it sets boundaries: approvals, sandboxes, spend limits, and logs. Capability and safety are designed together.",
          "start": 19,
          "end": 29
        }
      ],
      "elements": [
        {
