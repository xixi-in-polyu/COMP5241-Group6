    {
      "id": "scene-03",
      "chapterId": "ch-harness",
      "title": "The loop",
      "template": "process",
      "duration": 30,
      "knowledgeNodeIds": [],
      "captionMode": "bottom",
      "camera": {
        "zoomFrom": 1,
        "zoomTo": 1.04,
        "panX": 0.3,
        "panY": 0
      },
      "narration": [
        {
          "id": "scene-03-n1",
          "text": "The harness runs a loop. It observes the request, plans a step, calls a tool, and inspects the result.",
          "start": 0,
          "end": 9.5
        },
        {
          "id": "scene-03-n2",
          "text": "That result becomes new context. The model revises the plan and acts again, until the goal is met or a limit is reached.",
          "start": 9.5,
          "end": 19
        },
        {
          "id": "scene-03-n3",
          "text": "A harness is mostly this loop, made reliable: state, retries, cancellation, and evidence that the work really happened.",
          "start": 19,
          "end": 29
        }
      ],
      "elements": [
        {
          "id": "scene-03-title",
