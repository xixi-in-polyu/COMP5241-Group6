generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  role          String
  sessions      Session[]
  ownedCourses  Course[]   @relation("CourseOwner")
  taughtCourses Course[]   @relation("CourseTeacher")
  usageRuns     UsageRun[]

  miniCourses       MiniCourse[]
  miniCourseAiUsage MiniCourseAiUsage[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum CourseStatus {
  INGESTING
  AWAITING_MATERIAL_FIX
  EXTRACTING_ENTITIES
  AWAITING_ENTITY_REVIEW
  READY
  FAILED
}

enum MaterialStatus {
  UPLOADING
  UPLOADED
  PARSING
  READY
  DOWNLOAD_ONLY
  FAILED
}

enum CoursePublicationStatus {
  DRAFT
  PUBLISHED
}

enum CourseMaterialKind {
  FILE
  TEXT
}

enum CourseResourceKind {
  LINK
  VIDEO
  FILE
}

enum AssignmentStatus {
  INGESTING
  AWAITING_MATERIAL_FIX
  EXTRACTING_ENTITIES
  AWAITING_ENTITY_REVIEW
  READY_TO_GENERATE
  GENERATING
  DRAFT
  SUBMITTED
  FAILED
}

enum AssignmentMaterialKind {
  FILE
  TRANSCRIPT
}

enum QuestionVersionStatus {
  CANDIDATE
  ACCEPTED
  REJECTED
}

enum UsageRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum InteractiveLabGenerationStatus {
  IDLE
  GENERATING
  FAILED
}

enum InteractiveLabVersionSource {
  INITIAL
  ADD
  UPDATE
  RESTORE
}

enum InteractiveLabComponentType {
  auto
  flashcards
  matching
  ordering
  categorization
  timeline
  slider_explorer
  quick_check
}

model Course {
  id                   String                  @id @default(uuid())
  ownerId              String?
  teacherId            String?
  title                String
  category             String?
  description          String                  @default("")
  subject              String                  @default("")
  audience             String                  @default("")
  objectives           Json                    @default("[]")
  level                MiniCourseLevel         @default(BEGINNER)
  background           LearnerBackground       @default(EXPERIENCED)
  durationMinutes      Int                     @default(30)
  language             String                  @default("en")
  publicationStatus    CoursePublicationStatus @default(DRAFT)
  shareTokenHash       String?                 @unique
  archivedAt           DateTime?
  legacyMiniCourseId   String?                 @unique
  status               CourseStatus            @default(INGESTING)
  phase                String                  @default("Waiting for material processing")
  entityRevision       Int                     @default(0)
  knowledgeStale       Boolean                 @default(false)
  aiSelectionConfirmed Boolean                 @default(false)
  error                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  owner                User?                   @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  teacher              User?                   @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  materials            CourseMaterial[]
  resources            CourseResource[]
  chapters             CourseChapter[]
  segments             SourceSegment[]
  entities             KnowledgeEntity[]
  assignments          Assignment[]
  usageRuns            UsageRun[]
  usageEvents          UsageEvent[]
  usageBuckets         UsageBucket[]

  @@index([ownerId, archivedAt, updatedAt])
  @@index([ownerId, publicationStatus])
  @@index([teacherId, updatedAt])
  @@index([teacherId, status])
}

model CourseMaterial {
  id           String             @id @default(uuid())
  courseId     String
  chapterId    String?
  kind         CourseMaterialKind @default(FILE)
  name         String
  mimeType     String
  size         Int
  blobPathname String?            @unique
  textContent  String?
  aiSelected   Boolean            @default(true)
  status       MaterialStatus     @default(UPLOADED)
  pageCount    Int?
  errorCode    String?
  errorDetail  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter      CourseChapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  segments     SourceSegment[]

  @@index([courseId, status])
  @@index([chapterId])
}

model CourseResource {
  id        String             @id @default(uuid())
  courseId  String
  chapterId String?
  kind      CourseResourceKind
  title     String             @default("")
  url       String
  ordinal   Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   CourseChapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([courseId, chapterId, ordinal])
  @@index([courseId, chapterId])
}

model CourseChapter {
  id         String           @id @default(uuid())
  courseId   String
  ordinal    Int
  title      String
  objectives Json             @default("[]")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  blocks     CourseBlock[]
  resources  CourseResource[]
  materials  CourseMaterial[]

  @@unique([courseId, ordinal])
  @@index([courseId])
}

model CourseBlock {
  id        String              @id @default(uuid())
  chapterId String
  ordinal   Int
  type      MiniCourseBlockType
  payload   Json                @default("{}")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  chapter   CourseChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, ordinal])
  @@index([chapterId])
}

model SourceSegment {
  id                  String         @id @default(uuid())
  courseId            String
  materialId          String
  ordinal             Int
  locator             Json
  rawText             String
  normalizedText      String
  normalizationStatus String         @default("raw")
  hash                String
  createdAt           DateTime       @default(now())
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  material            CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, ordinal])
  @@index([courseId, ordinal])
}

model KnowledgeEntity {
  id          String            @id @default(uuid())
  courseId    String
  name        String
  description String            @default("")
  aliases     Json              @default("[]")
  importance  String            @default("supporting")
  selected    Boolean           @default(true)
  evidence    Json              @default("[]")
  parentId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent      KnowledgeEntity?  @relation("EntityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeEntity[] @relation("EntityHierarchy")

  @@index([courseId, selected])
  @@index([parentId])
}

model Assignment {
  id                String                      @id @default(uuid())
  courseId          String
  title             String
  status            AssignmentStatus            @default(INGESTING)
  phase             String                      @default("Waiting to select sources")
  entityRevision    Int                         @default(0)
  workflowHookToken String?
  ingestionRunId    String?
  originalBrief     Json?
  questions         Json                        @default("[]")
  failedSlots       Json                        @default("[]")
  qualityWarnings   Json                        @default("[]")
  version           Int                         @default(0)
  error             String?
  submittedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  course            Course                      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  materials         AssignmentMaterial[]
  segments          AssignmentSourceSegment[]
  entities          AssignmentKnowledgeEntity[]
  questionVersions  QuestionVersion[]
  usageRuns         UsageRun[]
  usageEvents       UsageEvent[]
  slotLeases        AssignmentSlotLease[]
  interactiveLabs   InteractiveLab[]

  @@index([courseId, updatedAt])
  @@index([courseId, status])
}

model InteractiveLab {
  id                String                         @id @default(uuid())
  assignmentId      String
  ordinal           Int
  generationStatus  InteractiveLabGenerationStatus @default(IDLE)
  generationError   String?
  activeVersionId   String?                        @unique
  approvedVersionId String?                        @unique
  approvedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  assignment        Assignment                     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  versions          InteractiveLabVersion[]        @relation("InteractiveLabVersions")
  activeVersion     InteractiveLabVersion?         @relation("InteractiveLabActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  approvedVersion   InteractiveLabVersion?         @relation("InteractiveLabApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)

  @@index([assignmentId, archivedAt, ordinal])
  @@index([assignmentId, generationStatus])
}

model InteractiveLabVersion {
  id                  String                      @id @default(uuid())
  labId               String
  sequence            Int
  source              InteractiveLabVersionSource
  instruction         String
  requestedType       InteractiveLabComponentType
  actualType          InteractiveLabComponentType
  payload             Json
  restoredFromVersion String?
  createdAt           DateTime                    @default(now())
  lab                 InteractiveLab              @relation("InteractiveLabVersions", fields: [labId], references: [id], onDelete: Cascade)
  activeFor           InteractiveLab?             @relation("InteractiveLabActiveVersion")
  approvedFor         InteractiveLab?             @relation("InteractiveLabApprovedVersion")

  @@unique([labId, sequence])
  @@index([labId, createdAt])
}

model AssignmentMaterial {
  id           String                    @id @default(uuid())
  assignmentId String
  name         String
  kind         AssignmentMaterialKind
  mimeType     String?
  size         Int?
  blobPathname String?                   @unique
  pageCount    Int?
  status       MaterialStatus            @default(UPLOADED)
  errorCode    String?
  errorDetail  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  assignment   Assignment                @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  segments     AssignmentSourceSegment[]

  @@index([assignmentId, status])
  @@index([assignmentId, kind])
}

model AssignmentSourceSegment {
  id                  String             @id @default(uuid())
  assignmentId        String
  materialId          String
  ordinal             Int
  locator             Json
  rawText             String
  normalizedText      String
  normalizationStatus String             @default("raw")
  hash                String
  createdAt           DateTime           @default(now())
  assignment          Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  material            AssignmentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, ordinal])
  @@index([assignmentId, ordinal])
}

model AssignmentKnowledgeEntity {
  id                   String                      @id @default(uuid())
  assignmentId         String
  sourceCourseEntityId String?
  name                 String
  description          String                      @default("")
  aliases              Json                        @default("[]")
  importance           String                      @default("supporting")
  selected             Boolean                     @default(true)
  evidence             Json                        @default("[]")
  parentId             String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  assignment           Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  parent               AssignmentKnowledgeEntity?  @relation("AssignmentEntityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             AssignmentKnowledgeEntity[] @relation("AssignmentEntityHierarchy")

  @@index([assignmentId, selected])
  @@index([assignmentId, sourceCourseEntityId])
  @@index([parentId])
}

model AssignmentSlotLease {
  id           String     @id @default(uuid())
  assignmentId String
  slotIndex    Int
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, slotIndex])
  @@index([expiresAt])
}

model QuestionVersion {
  id           String                @id @default(uuid())
  assignmentId String
  questionId   String
  instruction  String
  payload      Json
  status       QuestionVersionStatus @default(CANDIDATE)
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?
  assignment   Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, questionId, status])
}

model UsageRun {
  id           String         @id @default(uuid())
  courseId     String
  assignmentId String?
  teacherId    String
  kind         String
  status       UsageRunStatus @default(RUNNING)
  error        String?
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  teacher      User           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  events       UsageEvent[]

  @@index([teacherId, startedAt])
  @@index([courseId, startedAt])
}

model UsageEvent {
  id                String      @id @default(uuid())
  runId             String?
  courseId          String
  assignmentId      String?
  category          String
  operation         String
  provider          String?
  model             String?
  status            String
  attempt           Int         @default(1)
  durationMs        Int?
  requestPayload    Json?
  responsePayload   Json?
  requestBytes      Int         @default(0)
  responseBytes     Int         @default(0)
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  providerRequestId String?
  errorCode         String?
  errorDetail       String?
  metadata          Json        @default("{}")
  createdAt         DateTime    @default(now())
  completedAt       DateTime?
  payloadExpiresAt  DateTime?
  run               UsageRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment        Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([runId, createdAt])
  @@index([payloadExpiresAt])
}

model UsageBucket {
  id         String   @id @default(uuid())
  courseId   String
  teacherId  String
  windowKind String
  windowKey  String
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([teacherId, windowKind, windowKey])
  @@index([courseId, updatedAt])
}

enum MiniCourseStatus {
  DRAFT
  PUBLISHED
}

enum MiniCourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LearnerBackground {
  BEGINNER
  EXPERIENCED
}

enum MiniCourseBlockType {
  HEADING
  TEXT
  IMAGE
  VIDEO
  FILE
  ACTIVITY
  SUMMARY
}

/// A short, structured course: chapters of written sections, owned by one user.
model MiniCourse {
  id              String              @id @default(uuid())
  ownerId         String
  title           String
  summary         String              @default("")
  audience        String              @default("")
  subject         String              @default("")
  objectives      Json                @default("[]")
  resources       Json                @default("[]")
  level           MiniCourseLevel     @default(BEGINNER)
  background      LearnerBackground   @default(EXPERIENCED)
  durationMinutes Int                 @default(30)
  language        String              @default("en")
  status          MiniCourseStatus    @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  owner           User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chapters        MiniCourseChapter[]
  aiUsage         MiniCourseAiUsage[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, status])
}

model MiniCourseChapter {
  id         String            @id @default(uuid())
  courseId   String
  ordinal    Int
  title      String
  objectives Json              @default("[]")
  resources  Json              @default("[]")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  course     MiniCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  blocks     MiniCourseBlock[]

  @@unique([courseId, ordinal])
  @@index([courseId])
}

/// One content block; `payload` carries the type-specific data as JSON.
model MiniCourseBlock {
  id        String              @id @default(uuid())
  chapterId String
  ordinal   Int
  type      MiniCourseBlockType
  payload   Json                @default("{}")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  chapter   MiniCourseChapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, ordinal])
  @@index([chapterId])
}

/// One AI generation attempt made on behalf of a mini-course.
/// `courseId` stays optional because drafting happens before the course exists.
model MiniCourseAiUsage {
  id           String      @id @default(uuid())
  courseId     String?
  userId       String
  operation    String
  provider     String
  model        String
  status       String
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  durationMs   Int?
  errorDetail  String?
  createdAt    DateTime    @default(now())
  course       MiniCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([userId, createdAt])
}
